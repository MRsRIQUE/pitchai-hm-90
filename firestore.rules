rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Identidade de servidor: conta Firebase (email/senha) usada pelo backend.
    // Deve ser criada no console Firebase (Authentication > Users) com o mesmo
    // email configurado em FIREBASE_SERVER_EMAIL.
    function isServer() {
      return isSignedIn()
        && request.auth.token.email == 'pitchaihm-server@gen-lang-client-0224756084.firebaseapp.com';
    }

    function isOwnerOf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // Tokens de sincronização — o próprio token é a credencial da extensão
    // ------------------------------------------------------------------

    match /sync_tokens/{token} {
      allow get: if true;
      allow create, update, delete: if isServer()
        || (isSignedIn() && request.resource.data.uid == request.auth.uid);
    }

    // Config pública por token (consumida pela extensão via REST).
    // O dono só pode escrever no próprio token; leitura é aberta por design.
    match /live_configs_by_token/{token} {
      allow get: if true;
      allow write: if isServer()
        || (isSignedIn()
          && get(/databases/$(database)/documents/sync_tokens/$(token)).data.uid == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Dados do usuário
    // ------------------------------------------------------------------

    match /users/{uid} {
      allow read, write: if isOwnerOf(uid) || isServer();

      // Assinatura: muda somente via webhook/servidor (nunca pelo cliente).
      match /subscription/{subId} {
        allow read: if isOwnerOf(uid) || isServer();
        allow write: if isServer();
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwnerOf(uid) || isServer();
      }

      // Código de indicação do usuário — escrito pelo servidor.
      match /referral/{refId} {
        allow read: if isOwnerOf(uid) || isServer();
        allow write: if isServer();
      }

      // Vínculos indicador -> indicado — escritos pelo servidor.
      match /referrals/{refereeUid} {
        allow read: if isOwnerOf(uid) || isServer();
        allow write: if isServer();
      }

      // Uso diário — somente o servidor incrementa (cota não pode ser zerada pelo cliente).
      match /usage/{day} {
        allow read: if isOwnerOf(uid) || isServer();
        allow write: if isServer();
      }
    }

    // ------------------------------------------------------------------
    // Indicações (referrals)
    // ------------------------------------------------------------------

    match /referral_claims/{claimId} {
      allow read: if isServer() || isSignedIn();
      allow create: if isServer() || isSignedIn();
      allow update, delete: if isServer();
    }

    // Comissões de indicação — somente o servidor acessa.
    match /referral_commissions/{commissionId} {
      allow read, write: if isServer();
    }

    // Acessos de cortesia concedidos por admin — somente o servidor.
    match /comped_access/{userId} {
      allow read, write: if isServer();
    }

    // Código de indicação — público (é a chave de busca do convite).
    match /referral_codes/{code} {
      allow get: if true;
      allow create, update, delete: if isServer();
    }

    // ------------------------------------------------------------------
    // Ranking público de produtos
    // ------------------------------------------------------------------

    match /ranked_products/{productId} {
      allow read: if true;
      allow write: if isServer();
    }

    // ------------------------------------------------------------------
    // Admins — leitura pública (verificação de papel), escrita via servidor
    // ------------------------------------------------------------------

    match /admins/{uid} {
      allow read: if true;
      allow write: if isServer();
    }

    // Configurações administrativas (planos e custos) — somente servidor.
    match /admin_plans/{planId} {
      allow read: if isServer();
      allow write: if isServer();
    }

    match /admin_settings/{settingId} {
      allow read: if isServer();
      allow write: if isServer();
    }
  }
}