{
  "name": "pitchai-extension",
  "version": "0.16.7",
  "description": "Extensão Pitch AI para automação de lives do TikTok Shop",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "tiktok",
    "live",
    "automation",
    "ai",
    "extension"
  ],
  "author": "Pitch AI",
  "license": "MIT"
}
