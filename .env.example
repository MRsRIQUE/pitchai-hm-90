# Servidor (Firebase):
# - FIREBASE_SERVER_EMAIL e FIREBASE_SERVER_PASSWORD devem ser a conta do
#   servidor: crie-a no Firebase Console (Authentication > Users) com o email
#   "pitchaihm-server@gen-lang-client-0224756084.firebaseapp.com" (senha forte).
#   O backend usa essa conta para acessar o Firestore com as regras isServer().
FIREBASE_SERVER_EMAIL=
FIREBASE_SERVER_PASSWORD=

# AI (Gemini/TTS)
GEMINI_API_KEY=

# Pagamentos
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E2E (Playwright)
E2E_BASE_URL=
E2E_ALUNO_EMAIL=
E2E_ALUNO_PASSWORD=

# Dev apenas: desativa a exigência de assinatura HMAC nos endpoints da
# extensão (PITCHAI_SKIP_HMAC=1). Nunca definir em produção.
PITCHAI_SKIP_HMAC=
