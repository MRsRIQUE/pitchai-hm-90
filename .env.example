# Servidor (Firebase) — service account.
# Rotinas sem usuário (checkout, webhook do Stripe, jobs) escrevem no Firestore
# com uma service account: o token dela NÃO passa pelas regras de segurança, e é
# isso que evita o "Missing or insufficient permissions" que a conta técnica
# antiga (email/senha) dava quando as regras não estavam publicadas.
#
# Como obter: Firebase Console > Configurações do projeto > Contas de serviço >
# "Gerar nova chave privada". Cole o JSON inteiro (ou o JSON em base64, se o
# painel de deploy quebrar o valor multilinha) em FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=

# Alternativa aos dois campos avulsos, caso prefira não colar o JSON inteiro.
# FIREBASE_PRIVATE_KEY aceita a chave PEM com "\n" literal.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# AI (Gemini/TTS)
GEMINI_API_KEY=

# Curadoria de Produtos Quentes. UIDs/e-mails adicionais separados por vírgula.
# E-mails só recebem acesso quando estiverem verificados no Firebase Auth.
MASTER_UIDS=
MASTER_EMAILS=

# Pagamentos — somente modo live. Chaves test/sandbox são rejeitadas pela aplicação.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# E2E (Playwright)
E2E_BASE_URL=
E2E_ALUNO_EMAIL=
E2E_ALUNO_PASSWORD=

# Dev apenas: desativa a exigência de assinatura HMAC nos endpoints da
# extensão (PITCHAI_SKIP_HMAC=1). Nunca definir em produção.
PITCHAI_SKIP_HMAC=
